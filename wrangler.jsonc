{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fantasy-football-assistant",
  "compatibility_date": "2026-08-31",
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
